<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generation</title>
    <link rel="stylesheet" href="/pub/style.css">
</head>
<body>
    <h1 class="pokedexTitle">Pokedex</h1>
    <form class="pokemonButtons" action="/pokemonSelected" method="post">
        <% pokemons.forEach(pokemon => { %>
            <button class="pokemonButton" name="pokemonSelect" value="<%= pokemon.name %>">
                <h1><%= pokemon.name %></h1>
            </button>
        <% }) %>
    </form>
</body>
</html>