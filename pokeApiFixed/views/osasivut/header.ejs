<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/pub/style.css">
    <title>Header</title>
</head>
<body>
    <header>
        <h1 class="pokedexTitle">Pokedex</h1>
        <div class="actions">
            <form action="/goHome" method="POST">
                <input class="actionButton" type="submit" value="Home">
            </form>
            <form action="/searchPokemon" method="POST">
                <div class="searchArea">
                    <input type="text" name="pokemonSearch">
                    <input class="actionButton" type="submit" value="search">
                </div>
            </form>
        </div>
    </header>
</body>
</html>