<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pokemon</title>
    <link rel="stylesheet" href="/pub/style.css">
</head>
<body>
    <%- include("osasivut/header") %>
    <div id="pokemonGeneral">
        <div id="pokemonView">
            <h1><%= pokemon.name %></h1>
            <img src="<%= pokemon.sprites.other.showdown.front_default || pokemon.sprites.other[`official-artwork`].front_default || pokemon.sprites.front_default%>">
        </div>
        <div id="pokemonInfo">
            <div id="pokemonTypes">
                <h2>Types</h2>
                <ul>
                    <% pokemon.types.forEach(t => { %>
                        <li><%= t.type.name %></li>
                    <% }) %>
                </ul>
            </div>
            <div id="pokemonStats">
                <h2>Stats</h2>
                <ul>
                    <% pokemon.stats.forEach(t => { %>
                        <li><%= t.stat.name %>: <%= t.base_stat %></li>
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
    <%- include("osasivut/footer") %>
</body>
</html>