<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>pokeApi</title>
    <link rel="stylesheet" href="/pub/style.css">
</head>
<body>
    <h1 class="pokedexTitle">Pokedex</h1>
    <h1 class="textCenter">Generations</h1>
    <form class="genButtons" action="/genSelected" method="post">
        <button class="genButton" name="genSelect" value="1">I</button>
        <button class="genButton" name="genSelect" value="2">II</button>
        <button class="genButton" name="genSelect" value="3">III</button>
        <button class="genButton" name="genSelect" value="4">IV</button>
        <button class="genButton" name="genSelect" value="5">V</button>
        <button class="genButton" name="genSelect" value="6">VI</button>
        <button class="genButton" name="genSelect" value="7">VII</button>
        <button class="genButton" name="genSelect" value="8">VIII</button>
        <button class="genButton" name="genSelect" value="9">IX</button>
    </form>
</body>
</html>